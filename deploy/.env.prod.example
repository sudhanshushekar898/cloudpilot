# Copy to deploy/.env on the server and fill in. Never commit the real file.
# Generate secrets with:  openssl rand -base64 48

# Public host name. <elastic-ip>.sslip.io resolves to the IP, so no domain purchase is needed.
DOMAIN=203.0.113.10.sslip.io

# Released image tag (a git commit SHA on main). The deploy workflow sets this.
IMAGE_TAG=

DB_PASSWORD=
JWT_SECRET=
# Password of the public demo accounts (shown in the README). Must not be the dev default.
DEMO_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Optional: enables Claude for analysis and postmortems.
ANTHROPIC_API_KEY=
