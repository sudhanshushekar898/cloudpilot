# Copy to .env to override the defaults used by docker-compose.yml
DB_USERNAME=cloudpilot
DB_PASSWORD=change-me
DB_PORT=5432

# HMAC signing key for JWTs, at least 32 characters. Generate one with:
#   openssl rand -base64 48
# Remove this line locally to use the dev-only default (refused by the prod profile).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Demo accounts: admin@ / sre@ / dev@cloudpilot.dev
DEMO_SEED_USERS=true
DEMO_PASSWORD=CloudPilot#2026

# Optional: enables Claude for incident analysis (rule-based analysis is used without it).
# Get a key at https://platform.claude.com and never commit it.
ANTHROPIC_API_KEY=
